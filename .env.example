# ============================================
# AUTOMAIL Configuration Template
# ============================================
# Copy this file to .env and fill in your actual credentials.
# Do NOT commit your actual .env file to version control!

# Gmail credentials (REQUIRED)
# Generate an App Password at: https://myaccount.google.com/apppasswords
GMAIL_ADDRESS=your_email@gmail.com
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Target role (used in email generation placeholders)
TARGET_ROLE=AI/ML Engineer Intern

# Default resume to attach (must exist in the project root)
DEFAULT_RESUME=VINOTH_P RESUME.pdf